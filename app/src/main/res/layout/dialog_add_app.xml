<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/editTopicUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ссылка на 4PDA"
        android:inputType="textUri"
        android:autofillHints="url" />

    <EditText
        android:id="@+id/editAppName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Название приложения"
        android:inputType="textCapWords"
        android:autofillHints="name" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Название подтянется автоматически, если оставить пустым"
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_marginStart="4dp" />

    <EditText
        android:id="@+id/editPackageName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Имя пакета"
        android:inputType="text"
        android:autofillHints="packageName" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Имя пакета подтянется автоматически, но это не всегда работает"
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_marginStart="4dp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Папка">

        <AutoCompleteTextView
            android:id="@+id/editFolderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Можно вводить путь через / (например, Мои приложения/Социальные сети)"
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_marginStart="4dp" />

</LinearLayout>